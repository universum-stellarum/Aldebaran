# Copie para .env LOCAL ou preencha o ambiente da implantação no Dokploy.
# Nunca versione valores reais. Campos vazios obrigatórios devem ser preenchidos.
# Exclusivamente dev ou prod. Sem fallback.
APP_ENV=dev
SERVER_PORT=8888
CONFIG_SERVER_IMAGE=universum-config-server:local

# Identidades individuais. Hash {bcrypt}$2b$... com custo entre 10 e 16.
# Não coloque aspas: compose usa env_file format: raw para preservar os cifrões.
CONFIG_CLIENTS_0_NAME=auth-service
CONFIG_CLIENTS_0_USERNAME=auth-dev
CONFIG_CLIENTS_0_PASSWORD_HASH=
CONFIG_CLIENTS_1_NAME=finance-service
CONFIG_CLIENTS_1_USERNAME=finance-dev
CONFIG_CLIENTS_1_PASSWORD_HASH=
CONFIG_CLIENTS_2_NAME=notification-service
CONFIG_CLIENTS_2_USERNAME=notification-dev
CONFIG_CLIENTS_2_PASSWORD_HASH=

# Somente DIST_<NOME_DO_SERVICO>_* pode ser distribuído ao respectivo serviço.
DIST_AUTH_SERVICE_DATABASE_HOST=
DIST_AUTH_SERVICE_DATABASE_PORT=5432
DIST_AUTH_SERVICE_DATABASE_NAME=
DIST_AUTH_SERVICE_DATABASE_USERNAME=
DIST_AUTH_SERVICE_DATABASE_PASSWORD=
DIST_AUTH_SERVICE_JWT_SECRET=
DIST_AUTH_SERVICE_REDIS_HOST=
DIST_AUTH_SERVICE_REDIS_PASSWORD=
DIST_AUTH_SERVICE_NOTIFICATION_URL=

DIST_FINANCE_SERVICE_DATABASE_HOST=
DIST_FINANCE_SERVICE_DATABASE_PORT=5432
DIST_FINANCE_SERVICE_DATABASE_NAME=
DIST_FINANCE_SERVICE_DATABASE_USERNAME=
DIST_FINANCE_SERVICE_DATABASE_PASSWORD=
DIST_FINANCE_SERVICE_AUTH_URL=

DIST_NOTIFICATION_SERVICE_KAFKA_BOOTSTRAP_SERVERS=
# Valor completo JAAS gerado pelo operador; não é interpretado como expressão Spring.
DIST_NOTIFICATION_SERVICE_KAFKA_JAAS_CONFIG=
DIST_NOTIFICATION_SERVICE_PROVIDER_URL=
DIST_NOTIFICATION_SERVICE_PROVIDER_API_KEY=
